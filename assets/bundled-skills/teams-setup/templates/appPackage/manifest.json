{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "packageName": "com.residuum.agent",
  "developer": {
    "name": "${{BOT_DISPLAY_NAME}}",
    "websiteUrl": "https://github.com/Grizzly-Endeavors/residuum",
    "privacyUrl": "https://github.com/Grizzly-Endeavors/residuum",
    "termsOfUseUrl": "https://github.com/Grizzly-Endeavors/residuum"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "${{BOT_DISPLAY_NAME}}",
    "full": "${{TEAMS_APP_NAME}}"
  },
  "description": {
    "short": "${{BOT_DISPLAY_NAME}} in Microsoft Teams",
    "full": "Personal AI agent gateway integration with Microsoft Teams"
  },
  "accentColor": "#4F46E5",
  "bots": [
    {
      "botId": "${{BOT_ID}}",
      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": []
}
