#!/usr/bin/env bash
#
# Pre-push gate: the slow checks, once per push, on each pushed commit as pushed.
#
# Rust changes in the pushed range run clippy, the tests of the code those
# changes touch plus the source scans, the generated-types check, and the
# unused-dependency check (cargo shear). Web changes run ESLint and the style
# lint, svelte-check, and the web tests that import a changed file. CI runs the
# whole suites; this hook runs what the push can have changed. Every check runs
# even after one fails, so a push reports all of its problems at once, and a
# summary at the end lists what failed.
#
# The hook does not merge main into the commit. The merge queue tests every
# pull request merged with main before it lands, so a conflict with main shows
# on the pull request and the merged result is checked there.
#
# Written for bash 3.2, the shell macOS ships: no mapfile, no associative
# arrays, and arrays expand as ${arr[@]+"${arr[@]}"} so an empty one is safe
# under set -u.
#
# Bypassing this hook with --no-verify is forbidden, for a push as for a
# commit. If it fails, fix the underlying issue — a hook you route around is a
# hook that isn't there.
set -uo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BOLD='\033[1m'
NC='\033[0m'

ZERO_SHA=0000000000000000000000000000000000000000
MAIN_REF=refs/remotes/origin/main
# The paths that run the Rust checks. This is the RUST_PATHS_RE of the
# `changes` job in .github/workflows/ci.yml, which decides when CI runs the same
# checks; change both together.
RUST_PATHS_RE='^(src|tests|assets|crates|\.cargo)/|^(build\.rs|Cargo\.toml|Cargo\.lock|rust-toolchain\.toml|clippy\.toml|rustfmt\.toml|deny\.toml)$|^web/src/lib/generated/|^web/src/styles/tokens\.css$|^web/app-shell-csp\.txt$|^(scripts/((check|export)-generated-types|affected-packages(-test)?|check-crate-isolation)\.sh|\.github/workflows/(ci|rust-checks|release)\.yml)$'

note() { echo -e "${YELLOW}$1${NC}" >&2; }

REPO_ROOT="$(git rev-parse --show-toplevel)"
CHECKOUT_HEAD="$(git rev-parse HEAD)"
# Git hands hooks its repository variables, which in a linked worktree point at
# the worktree. The hook's git calls must find the repository from the directory
# they run in, including a temporary worktree, so it runs without them (the
# reasoning is in .githooks/pre-commit).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR
# The target directory every check that builds uses, set per pushed commit
# below. A commit checked in place builds into the checkout's own target
# directory (CARGO_TARGET_DIR when set, else target/), so the push reuses the
# crate artifacts the checkout's cargo runs already left there. A commit checked
# in a temporary tree builds into target/pre-push, which keeps the detached tree
# from replacing the artifacts a cargo run in the checkout depends on.
# target/pre-push keeps its own builds from push to push, and the stable tree
# (target/pre-push/tree) keeps the modification times of unchanged files, which
# is what lets Cargo reuse those builds.
PRE_PUSH_TARGET_DIR="$REPO_ROOT/target/pre-push"
STABLE_DIR="$REPO_ROOT/target/pre-push"
STABLE_TREE="$STABLE_DIR/tree"
STABLE_LOCK="$STABLE_DIR/tree.lock"
# The commit web/dist was last built from in the stable tree.
DIST_COMMIT_FILE="$STABLE_DIR/tree-dist-commit"

# Git passes one line per pushed ref on stdin. Read them all up front: the
# checks below run tools that would otherwise read the rest of it.
PUSHED_REFS=()
while IFS= read -r line || [ -n "$line" ]; do
    PUSHED_REFS+=("$line")
done

# MAIN_KNOWN: some copy of origin/main exists. A new branch's changes are
# measured against it, since a new branch has no remote commit to measure from.
MAIN_KNOWN=0
# A fetch that can't reach the remote must not hang on a credential prompt.
if ! GIT_TERMINAL_PROMPT=0 git fetch --quiet origin "+refs/heads/main:$MAIN_REF"; then
    note "WARNING: couldn't fetch main from origin; a new branch is measured against the last origin/main this checkout fetched."
fi
git rev-parse --verify --quiet "$MAIN_REF" >/dev/null && MAIN_KNOWN=1

# Which parts of the tree the commits being pushed change. The range starts at
# what the remote already has, or for a new branch where it left main. With
# neither, every check runs and CHANGED_KNOWN stays 0, which makes the test
# selection below choose every test, since it has no list of changed paths.
TOUCHES_RUST=0
TOUCHES_WEB=0
CHANGED_PATHS=""
CHANGED_KNOWN=0
classify_range() {
    local local_sha="$1" remote_sha="$2" base=""
    CHANGED_PATHS=""
    CHANGED_KNOWN=0
    if [ "$remote_sha" != "$ZERO_SHA" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        base="$remote_sha"
    elif [ "$MAIN_KNOWN" = 1 ]; then
        base="$(git merge-base "$local_sha" "$MAIN_REF" 2>/dev/null)"
    fi
    if [ -z "$base" ]; then
        TOUCHES_RUST=1
        TOUCHES_WEB=1
        return
    fi
    # --no-renames lists both sides of a move, so the module a file left counts
    # as changed too.
    # core.quotePath=false keeps non-ASCII paths unquoted, so they match the arms below.
    # A diff that fails says nothing about what changed, so it runs every check,
    # as a range with no base does.
    if ! CHANGED_PATHS="$(git -c core.quotePath=false diff --name-only --no-renames "$base" "$local_sha")"; then
        note "WARNING: couldn't list the files changed since $base; running every check."
        CHANGED_PATHS=""
        TOUCHES_RUST=1
        TOUCHES_WEB=1
        return
    fi
    CHANGED_KNOWN=1
    grep -qE "$RUST_PATHS_RE" <<<"$CHANGED_PATHS" && TOUCHES_RUST=1
    grep -v '^web/.*\.md$' <<<"$CHANGED_PATHS" | grep -q '^web/' && TOUCHES_WEB=1
}

# Every check runs and its result is recorded; nothing exits early.
FAILED=()
PASSED=()
# Names each result after its branch when one push checks several.
CHECK_SCOPE=""
run_check() {
    local name="$CHECK_SCOPE$1"
    shift
    echo -e "${BOLD}==> $name${NC}"
    local started=$SECONDS
    if "$@" </dev/null; then
        PASSED+=("$name ($((SECONDS - started))s)")
    else
        FAILED+=("$name ($((SECONDS - started))s)")
        echo -e "${RED}FAILED: $name${NC}" >&2
    fi
}

# Install web dependencies when they are missing or older than the lockfile,
# as `just` does before any web recipe.
ensure_web_deps() {
    local web="$1"
    # A node_modules borrowed from this checkout was matched to the lockfile
    # when it was linked, and the fresh checkout makes the lockfile look newer
    # than it. npm ci would empty the checkout's copy through the link.
    [ -L "$web/node_modules" ] && return 0
    [ "$web/node_modules/.package-lock.json" -nt "$web/package-lock.json" ] && return 0
    echo "Installing web dependencies in $web..."
    (cd "$web" && npm ci --no-audit --no-fund >/dev/null)
}

# TEMP_TREE is the tree the checks of the current commit run in. TEMP_DIR is
# set only when that tree is a temporary worktree, which the cleanup removes;
# the stable tree stays. LOCK_HELD is 1 while this hook holds the stable lock.
TEMP_DIR=""
TEMP_TREE=""
LOCK_HELD=0
# What prepare_worktree checked the commit in, for the line that names it.
TREE_NAME=""
TEST_LOG=""
TS_EXPORT_DIR=""
cleanup_test_scratch() {
    if [ -n "$TEST_LOG" ]; then
        rm -f "$TEST_LOG"
        TEST_LOG=""
    fi
    if [ -n "$TS_EXPORT_DIR" ]; then
        rm -rf "$TS_EXPORT_DIR"
        TS_EXPORT_DIR=""
    fi
}
cleanup() {
    cleanup_test_scratch
    # Unlink the borrowed node_modules first so nothing below can reach
    # through it into this checkout's copy.
    if [ -n "$TEMP_TREE" ] && [ -L "$TEMP_TREE/web/node_modules" ]; then
        rm -f "$TEMP_TREE/web/node_modules"
    fi
    if [ -n "$TEMP_DIR" ]; then
        git worktree remove --force "$TEMP_TREE" >/dev/null 2>&1 || rm -rf "$TEMP_TREE"
        git worktree prune >/dev/null 2>&1
        rm -rf "$TEMP_DIR"
        TEMP_DIR=""
    fi
    TEMP_TREE=""
    if [ "$LOCK_HELD" = 1 ]; then
        rm -rf "$STABLE_LOCK"
        LOCK_HELD=0
    fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Makes the stable tree a checkout of the commit $1. A checkout rewrites only
# the files that differ, so every other file keeps its modification time and
# Cargo keeps its builds. Returns 1 when that fails.
refresh_stable_tree() {
    local sha="$1" listing
    # Drops the registration of a tree whose directory is gone.
    git worktree prune >/dev/null 2>&1
    listing="$(git worktree list --porcelain)"
    if [ -d "$STABLE_TREE" ] && grep -Fxq "worktree $STABLE_TREE" <<<"$listing"; then
        (cd "$STABLE_TREE" && git checkout --quiet --force --detach "$sha" && git clean -fdq)
        return
    fi
    # A directory that is not a registered worktree is removed and added again.
    rm -rf "$STABLE_TREE"
    git worktree prune >/dev/null 2>&1
    git worktree add --quiet --detach "$STABLE_TREE" "$sha" >&2
}

# Points the stable tree's web/node_modules at this checkout's copy when the
# lockfiles match. Otherwise the tree has no link, and ensure_web_deps installs
# its own copy when the web checks need one.
link_stable_node_modules() {
    if [ -L "$STABLE_TREE/web/node_modules" ]; then
        rm -f "$STABLE_TREE/web/node_modules"
    fi
    if [ -d "$REPO_ROOT/web/node_modules" ] && cmp -s "$REPO_ROOT/web/package-lock.json" "$STABLE_TREE/web/package-lock.json"; then
        # A real directory is left by an npm ci run in the tree; the link replaces it.
        if [ -d "$STABLE_TREE/web/node_modules" ]; then
            rm -rf "$STABLE_TREE/web/node_modules"
        fi
        ln -s "$REPO_ROOT/web/node_modules" "$STABLE_TREE/web/node_modules"
    fi
}

# Checks out the commit $1 in the stable tree under the stable lock. Returns 1,
# having said why, when another push holds the lock or the tree cannot be
# prepared, and the caller then uses a temporary worktree. A lock with no pid
# yet is held: the window between creating the lock directory and writing the
# pid is too short to call it stale, and a holder that died in that window needs
# the lock removed by hand. A stale lock taken over by two pushes at the same
# moment can still race; that needs two pushes after one crashed holder, and the
# result is a second push checking in the same tree. Never call it in a
# subshell: the lock and the cleanup trap need the variables it sets.
prepare_stable_tree() {
    local sha="$1" holder=""
    if ! mkdir -p "$STABLE_DIR"; then
        note "couldn't create $STABLE_DIR; checking in a temporary worktree instead."
        return 1
    fi
    if ! mkdir "$STABLE_LOCK" 2>/dev/null; then
        holder="$(cat "$STABLE_LOCK/pid" 2>/dev/null)"
        if [ -z "$holder" ] || kill -0 "$holder" 2>/dev/null; then
            note "the stable pre-push tree is locked${holder:+ by pid $holder}; checking in a temporary worktree instead. If no push is running, remove $STABLE_LOCK."
            return 1
        fi
        note "the stable pre-push tree's lock was held by pid $holder, which is no longer running; taking it over."
        rm -rf "$STABLE_LOCK"
        if ! mkdir "$STABLE_LOCK" 2>/dev/null; then
            note "another push took the stable pre-push tree first; checking in a temporary worktree instead."
            return 1
        fi
    fi
    LOCK_HELD=1
    printf '%s\n' "$$" >"$STABLE_LOCK/pid"
    TEMP_TREE="$STABLE_TREE"
    if ! refresh_stable_tree "$sha"; then
        note "couldn't prepare the stable pre-push tree at $STABLE_TREE; checking in a temporary worktree instead."
        cleanup
        return 1
    fi
    link_stable_node_modules
    TREE_NAME="the stable pre-push tree"
}

# Checks out the commit $1 in a new temporary worktree that borrows this
# checkout's node_modules. Leaves its path in TEMP_TREE. Returns 1 on failure.
# Never call it in a subshell: the cleanup trap needs the paths it sets.
prepare_temp_worktree() {
    local sha="$1"
    TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/residuum-pre-push.XXXXXX")" || return 1
    TEMP_TREE="$TEMP_DIR/tree"
    git worktree add --quiet --detach "$TEMP_TREE" "$sha" >&2 || return 1
    # Symlinking node_modules skips an install, which only holds while the
    # pushed commit's lockfile is the one this checkout has.
    if [ -d "$REPO_ROOT/web/node_modules" ] && cmp -s "$REPO_ROOT/web/package-lock.json" "$TEMP_TREE/web/package-lock.json"; then
        ln -s "$REPO_ROOT/web/node_modules" "$TEMP_TREE/web/node_modules"
    fi
    TREE_NAME="a temporary worktree"
}

# Checks out the pushed commit $1 in the stable tree when it can be used, and
# otherwise in a temporary worktree. Leaves the tree's path in TEMP_TREE and
# names the tree in TREE_NAME. Returns 1 on failure.
# Never call it in a subshell: the cleanup trap needs the paths it sets.
prepare_worktree() {
    local sha="$1"
    cleanup
    # Cargo reads .cargo/config.toml from every parent directory, so a tree below
    # the checkout would build with the checkout's configuration as well as its own.
    if [ -d "$REPO_ROOT/.cargo" ]; then
        note "$REPO_ROOT/.cargo exists, and Cargo would read its configuration in the stable tree; checking in a temporary worktree instead."
    elif prepare_stable_tree "$sha"; then
        return 0
    fi
    prepare_temp_worktree "$sha"
}

# Whether the Rust source file $1 declares the module $2 (`mod name;`, with or
# without a visibility).
declares_module() {
    grep -qE "^(pub(\([a-z]+\))? )?mod $2;" "$1" 2>/dev/null
}

# Whether the tree $1 has a member crate $2: a directory under crates/ that
# holds a manifest. Its package is residuum-$2.
is_member() {
    [ -f "$1/crates/$2/Cargo.toml" ]
}

# The root unit-test filters of the push being planned, space-separated. The
# source scans are always among them.
UNIT_FILTERS=""
add_filter() {
    case " $UNIT_FILTERS " in
    *" $1 "*) ;;
    *) UNIT_FILTERS="$UNIT_FILTERS $1" ;;
    esac
}

# Sets PICKED to the words scripts/affected-packages.sh prints for the mode $2
# (--affected or --members) on the newline-separated paths $3. When the script
# is missing or fails, PICKED is the fallback words given after the paths and
# the function returns 1: a selection may check more, never less. The script's
# stderr says what it chose.
pick_packages() {
    local dir="$1" mode="$2" paths="$3" out
    shift 3
    if out="$(cd "$dir" && ./scripts/affected-packages.sh "$mode" <<<"$paths")"; then
        PICKED=()
        read -r -a PICKED <<<"$out"
        return 0
    fi
    echo -e "${YELLOW}WARNING: scripts/affected-packages.sh $mode failed; checking $*.${NC}" >&2
    PICKED=("$@")
    return 1
}

# The Rust checks the changed paths call for: which packages clippy checks, and
# which tests run. CI runs the whole suite, so this picks what the push can have
# changed. One arm per changed path; the arms of a push combine: filters
# accumulate, a choice of every test wins over a filtered one, and the member
# list is the union.
#   src/lib.rs, src/main.rs        every root unit test, lib and bin
#   src/<mod>/**, src/<mod>.rs     the root unit tests of that module (`<mod>::`),
#                                  and the bin's too when main.rs declares it
#   other src/** paths             every root unit test (no module declares them)
#   Cargo.toml, Cargo.lock, rust-toolchain.toml, clippy.toml, rustfmt.toml,
#   deny.toml, .cargo/**           the testing::manifest_scan filter
#   crates/<dir>/Cargo.toml        the same filter, and the member's tests
#   crates/<dir>/** of a member    that member's tests, and those of every member
#                                  that depends on it
#   crates/** outside a member     the testing::manifest_scan filter
#   build.rs, the generated web types, the generated-types and isolation
#   scripts, affected-packages*, the CI workflows
#                                  no test added (clippy and the generated-types
#                                  check still cover them)
#   assets/**, tests/fixtures/**   every unit test of every package, and every
#                                  integration test, since both read them
#   tests/it/**                    the `it` binary, which holds every integration
#                                  test except ts_export
#   tests/<name>.rs                that integration test
#   other tests/*/*                every integration test
#   web/src/styles/tokens.css      the member tests of residuum-net, which
#                                  embeds it (crates/net/src/browser_landing.rs)
#   web/app-shell-csp.txt, .github/workflows/release.yml
#                                  every root unit test
# Clippy checks the packages scripts/affected-packages.sh --affected picks for
# all the changed paths, and every package when there is no list of them.
# The source scans (testing::source_scan) run whenever the Rust checks run at
# all. A push with no list of changed paths selects every test.
# Sets UNIT_ARGS, CLIPPY_ARGS, MEMBER_ARGS and INTEGRATION_ARGS (cargo
# arguments; MEMBER_ARGS and INTEGRATION_ARGS are empty when none is called
# for) and prints the choice.
plan_rust_tests() {
    local dir="$1" path mod name known unit_reason="" integration_reason=""
    local unit_all=0 unit_workspace=0 unit_bins=0 integration_all=0
    local tests=" " test_names member_paths="" member_reason="" clippy_reason=""
    test_names=()
    UNIT_FILTERS="testing::source_scan"
    UNIT_ARGS=()
    CLIPPY_ARGS=()
    MEMBER_ARGS=()
    INTEGRATION_ARGS=()
    if [ "$CHANGED_KNOWN" = 0 ]; then
        unit_workspace=1
        unit_reason="no list of changed paths"
        integration_all=1
        integration_reason="no list of changed paths"
    fi
    while IFS= read -r path; do
        case "$path" in
        src/lib.rs | src/main.rs)
            unit_all=1
            unit_reason="$path changed"
            ;;
        src/*)
            mod="${path#src/}"
            mod="${mod%%/*}"
            mod="${mod%.rs}"
            known=0
            if declares_module "$dir/src/lib.rs" "$mod"; then
                known=1
            fi
            if declares_module "$dir/src/main.rs" "$mod"; then
                known=1
                unit_bins=1
            fi
            if [ "$known" = 0 ]; then
                unit_all=1
                unit_reason="$path belongs to no module"
            else
                add_filter "$mod::"
            fi
            ;;
        Cargo.toml | Cargo.lock | rust-toolchain.toml | clippy.toml | rustfmt.toml | deny.toml | .cargo/*)
            add_filter testing::manifest_scan
            ;;
        crates/*)
            name="${path#crates/}"
            name="${name%%/*}"
            if is_member "$dir" "$name"; then
                member_paths="$member_paths$path"$'\n'
            fi
            if [ "$path" = "crates/$name/Cargo.toml" ] || ! is_member "$dir" "$name"; then
                add_filter testing::manifest_scan
            fi
            ;;
        build.rs | web/src/lib/generated/* | scripts/check-generated-types.sh | scripts/export-generated-types.sh | scripts/affected-packages* | scripts/check-crate-isolation.sh | .github/workflows/ci.yml | .github/workflows/rust-checks.yml)
            # No test reads these; clippy and the generated-types check still cover them.
            ;;
        assets/* | tests/fixtures/*)
            unit_workspace=1
            unit_reason="$path is read by unit tests"
            integration_all=1
            integration_reason="$path is read by integration tests"
            ;;
        tests/it/*)
            name=it
            case "$tests" in
            *" $name "*) ;;
            *)
                tests="$tests$name "
                test_names+=("$name")
                ;;
            esac
            ;;
        tests/*/*)
            integration_all=1
            integration_reason="$path changed"
            ;;
        tests/*.rs)
            name="${path#tests/}"
            name="${name%.rs}"
            # A deleted test has no binary to run.
            if [ -f "$dir/tests/$name.rs" ]; then
                case "$tests" in
                *" $name "*) ;;
                *)
                    tests="$tests$name "
                    test_names+=("$name")
                    ;;
                esac
            fi
            ;;
        web/src/styles/tokens.css)
            member_paths="$member_paths$path"$'\n'
            ;;
        *)
            # Only paths the Rust checks cover count: a docs or web file that no
            # test reads selects nothing. Those that reach here are files tests
            # read by path (web/app-shell-csp.txt, .github/workflows/release.yml).
            if grep -qE "$RUST_PATHS_RE" <<<"$path"; then
                unit_all=1
                unit_reason="$path is read by unit tests"
            fi
            ;;
        esac
    done <<<"$CHANGED_PATHS"

    if [ "$unit_workspace" = 1 ]; then
        UNIT_ARGS=(--workspace --lib --bins)
        echo "Unit tests: every one of every package ($unit_reason)."
    elif [ "$unit_all" = 1 ]; then
        UNIT_ARGS=(-p residuum --lib --bins)
        echo "Unit tests: every root one, lib and bin ($unit_reason)."
    else
        UNIT_ARGS=(-p residuum --lib)
        if [ "$unit_bins" = 1 ]; then
            UNIT_ARGS+=(--bins)
        fi
        UNIT_ARGS+=(--)
        for mod in $UNIT_FILTERS; do
            UNIT_ARGS+=("$mod")
        done
        if [ "$unit_bins" = 1 ]; then
            echo "Unit tests: root, filtered to $UNIT_FILTERS (lib and bin)."
        else
            echo "Unit tests: root, filtered to $UNIT_FILTERS."
        fi
    fi

    CLIPPY_ARGS=(--workspace)
    if [ "$CHANGED_KNOWN" = 0 ]; then
        clippy_reason="no list of changed paths"
    elif pick_packages "$dir" --affected "$CHANGED_PATHS" --workspace; then
        if [ "${#PICKED[@]}" -gt 0 ]; then
            CLIPPY_ARGS=("${PICKED[@]}")
            clippy_reason="the packages the changed paths touch and their dependents"
        else
            clippy_reason="the script named no package"
        fi
    else
        clippy_reason="the selection failed"
    fi
    echo "Clippy: ${CLIPPY_ARGS[*]} ($clippy_reason)."

    if [ -n "$member_paths" ]; then
        if pick_packages "$dir" --members "$member_paths" --workspace --exclude residuum; then
            member_reason="the member crates the changed paths touch and their dependents"
        else
            member_reason="the selection failed"
        fi
        if [ "${#PICKED[@]}" -gt 0 ]; then
            MEMBER_ARGS=("${PICKED[@]}" --lib --tests)
            echo "Member tests: ${PICKED[*]} ($member_reason)."
        else
            echo "Member tests: none (no changed path is in a member crate)."
        fi
    fi

    if [ "$integration_all" = 1 ]; then
        INTEGRATION_ARGS=(-p residuum --test '*')
        echo "Integration tests: every one ($integration_reason)."
    elif [ "${#test_names[@]}" -gt 0 ]; then
        INTEGRATION_ARGS=(-p residuum)
        for name in "${test_names[@]}"; do
            INTEGRATION_ARGS+=(--test "$name")
        done
        echo "Integration tests: ${test_names[*]}."
    else
        echo "Integration tests: none (no tests/ path changed)."
    fi
}

# Runs cargo test with the given arguments. The source scans are among the
# tests the hook always selects: they fail any test that waits on elapsed time
# instead of an event. When one fails, its name in the output gets the hint on
# how to fix it. The output is kept in TEST_LOG for the search and removed
# afterwards. The ts_export integration test writes the generated types to a
# scratch directory, so the checkout's web/src/lib/generated is never rewritten
# by a push.
run_cargo_test() {
    local dir="$1" result=0
    shift
    TEST_LOG="$(mktemp)" || return 1
    TS_EXPORT_DIR="$(mktemp -d)" || return 1
    (cd "$dir" && RESIDUUM_TS_EXPORT_DIR="$TS_EXPORT_DIR" CARGO_TARGET_DIR="$PRE_PUSH_TARGET_DIR" cargo test --quiet --no-fail-fast "$@") 2>&1 | tee "$TEST_LOG" || result=1
    if [ "$result" -ne 0 ] && grep -qE '^(---- |    )testing::source_scan::' "$TEST_LOG"; then
        echo -e "${RED}ERROR: a source scan failed. A test that waits on elapsed time should wait on the event instead (CONTRIBUTING.md, \"Waiting in tests\").${NC}" >&2
    fi
    cleanup_test_scratch
    return "$result"
}

# The web app's protocol types are generated from the Rust types. The check
# regenerates them into a scratch directory and compares the result with the
# index, so a push that changes Rust has to carry the regenerated files, and the
# checkout's own files and index are left as they are.
generated_types_check() {
    (cd "$1" && CARGO_TARGET_DIR="$PRE_PUSH_TARGET_DIR" scripts/check-generated-types.sh) && return 0
    echo -e "${RED}ERROR: web/src/lib/generated is out of date with the Rust types. Run 'just types', stage the result, and commit again.${NC}" >&2
    return 1
}

# Whether web/dist must be built before the Rust checks of the commit $2 in the
# tree $1, which the caller has entered. The stable tree reuses its dist while
# no web source differs from the commit the dist was built from, Markdown aside.
# Any other tree rebuilds when the push changes web/, and always when it has no
# dist of its own: a temporary worktree has none, and the checkout's dist is
# rebuilt when it is missing.
web_dist_needs_build() {
    local dir="$1" sha="$2" recorded=""
    if [ "$dir" = "$STABLE_TREE" ]; then
        recorded="$(cat "$DIST_COMMIT_FILE" 2>/dev/null)"
        [ -n "$recorded" ] && [ -f web/dist/index.html ] && [ -f web/dist/sw.js ] &&
            git diff --quiet "$recorded" "$sha" -- web ':(exclude)web/**/*.md' && return 1
        return 0
    fi
    [ "$dir" != "$REPO_ROOT" ] || [ "$TOUCHES_WEB" = 1 ] || [ ! -f web/dist/index.html ] || [ ! -f web/dist/sw.js ]
}

# The unused-dependency check. cargo-shear reads the manifests and sources and
# builds nothing, so it needs neither web/dist nor a target directory, and
# runs even when the web build fails. CI pins its version in rust-checks.yml,
# which this reads from the tree being checked. cargo-shear is a separate
# install, so a machine without it does not refuse the push: SHEAR_NOTE makes
# the summary say the check did not run and how to install it, and CI runs it.
# A different installed version still runs, with a note, because its findings
# can differ from CI's.
SHEAR_NOTE=""
shear_check() {
    local dir="$1" pinned installed
    pinned="$(sed -n 's/^ *CARGO_SHEAR_VERSION: \(.*\)$/\1/p' "$dir/.github/workflows/rust-checks.yml" 2>/dev/null)"
    if ! command -v cargo-shear >/dev/null 2>&1; then
        SHEAR_NOTE="cargo-shear is not installed, so the unused-dependency check did not run here (CI runs it). Install v${pinned}: cargo install --locked cargo-shear --version ${pinned}"
        return
    fi
    installed="$(cargo shear --version 2>/dev/null | sed -n 's/^Version: //p')"
    if [ "$installed" != "$pinned" ]; then
        SHEAR_NOTE="cargo-shear ${installed:-of unknown version} is installed and CI pins ${pinned}, so this check's findings can differ from CI's. Install v${pinned}: cargo install --locked cargo-shear --version ${pinned}"
    fi
    run_check "cargo shear" cargo_in "$dir" shear --locked --deny-warnings
}

run_rust_checks() {
    local dir="$1" sha="$2"
    shear_check "$dir"
    (
        cd "$dir" || exit 1
        # build.rs refuses to compile without web/dist, and the gateway's tests
        # read the built service worker, so the Rust checks build it when
        # web_dist_needs_build says the dist is not the one they need.
        if web_dist_needs_build "$dir" "$sha"; then
            ensure_web_deps web || exit 1
            echo "Building web/dist..."
            # The stable tree's record names the commit the dist came from, so it
            # goes once the build has replaced the dist, and is written after
            # the build succeeds.
            if [ "$dir" = "$STABLE_TREE" ]; then
                rm -f "$DIST_COMMIT_FILE"
            fi
            # Vite's output, chunk-size advice included, only matters when the
            # build fails.
            local build_output
            build_output="$(cd web && npm run build 2>&1)" || {
                echo "$build_output" >&2
                exit 1
            }
            if [ "$dir" = "$STABLE_TREE" ]; then
                printf '%s\n' "$sha" >"$DIST_COMMIT_FILE" || {
                    echo "couldn't record the commit web/dist was built from in $DIST_COMMIT_FILE" >&2
                    exit 1
                }
            fi
        fi
    ) || {
        FAILED+=("${CHECK_SCOPE}web build for the Rust checks")
        echo -e "${RED}FAILED: building web/dist, which the Rust build needs. Skipping the Rust checks.${NC}" >&2
        return
    }
    plan_rust_tests "$dir"
    run_check "clippy" cargo_in "$dir" clippy --all-targets --all-features "${CLIPPY_ARGS[@]}" -- -D warnings
    run_check "unit tests (changed modules, source scans)" run_cargo_test "$dir" "${UNIT_ARGS[@]}"
    if [ "${#MEMBER_ARGS[@]}" -gt 0 ]; then
        run_check "member tests (changed crates)" run_cargo_test "$dir" "${MEMBER_ARGS[@]}"
    fi
    if [ "${#INTEGRATION_ARGS[@]}" -gt 0 ]; then
        run_check "integration tests (changed)" run_cargo_test "$dir" "${INTEGRATION_ARGS[@]}"
    fi
    run_check "generated types" generated_types_check "$dir"
}

cargo_in() {
    local dir="$1"
    shift
    (cd "$dir" && CARGO_TARGET_DIR="$PRE_PUSH_TARGET_DIR" cargo "$@")
}

# The web tests that import a changed web file (`vitest related`). CI runs the
# whole suite. The whole suite runs here when the change is to something that
# decides how every test builds or runs: package.json and the lockfile (the
# versions the tests run on), the Vite, Vitest, Svelte and TypeScript
# configuration, and the files every test run loads through that configuration:
# the component setup file and the hang guard (src/test/setup.*, src/test/guard.*)
# and the service worker plugin (build/service-worker*). The import graph can't
# tie those to a test, and they change how every test runs, so an import-graph
# selection would miss tests they affect. With no list of changed paths it runs
# the whole suite too.
web_tests() {
    local dir="$1" path rel reason="" all=0 files
    files=()
    if [ "$CHANGED_KNOWN" = 0 ]; then
        all=1
        reason="no list of changed paths"
    fi
    while IFS= read -r path; do
        case "$path" in
        web/package.json | web/package-lock.json | web/vite.config.* | web/vitest.config.* | web/svelte.config.js | web/tsconfig* | web/*/tsconfig*.json | web/src/test/setup.* | web/src/test/guard.* | web/build/service-worker*)
            all=1
            reason="$path changed"
            ;;
        web/*)
            rel="${path#web/}"
            # A deleted file has nothing to import it.
            if [ -f "$dir/web/$rel" ]; then
                files+=("$rel")
            fi
            ;;
        esac
    done <<<"$CHANGED_PATHS"

    if [ "$all" = 1 ]; then
        echo "Web tests: every one ($reason)."
        npm --prefix "$dir/web" test
    elif [ "${#files[@]}" -eq 0 ]; then
        echo "Web tests: none (no changed web file is left to select tests from)."
    else
        echo "Web tests: those that import any of the ${#files[@]} changed web files."
        (cd "$dir/web" && npx --no-install vitest related --run --passWithNoTests "${files[@]}")
    fi
}

run_web_checks() {
    local dir="$1"
    if ! ensure_web_deps "$dir/web"; then
        FAILED+=("${CHECK_SCOPE}npm ci")
        echo -e "${RED}FAILED: installing web dependencies. Skipping the web checks.${NC}" >&2
        return
    fi
    run_check "web lint (ESLint, style lint)" npm --prefix "$dir/web" run lint
    run_check "web type check (svelte-check)" npm --prefix "$dir/web" run check
    run_check "web tests (Vitest, changed files)" web_tests "$dir"
}

PUSHED_COMMITS=0
for line in ${PUSHED_REFS[@]+"${PUSHED_REFS[@]}"}; do
    read -r _ local_sha _ _ <<<"$line"
    [ "$local_sha" = "$ZERO_SHA" ] || PUSHED_COMMITS=$((PUSHED_COMMITS + 1))
done

CHECKED_ANY=0
# The commits already checked, space-separated. A branch and a tag on the same
# commit are checked once.
CHECKED_SHAS=" "
for line in ${PUSHED_REFS[@]+"${PUSHED_REFS[@]}"}; do
    read -r local_ref local_sha _remote_ref remote_sha <<<"$line"
    # Deleting a remote branch pushes nothing to check.
    [ "$local_sha" = "$ZERO_SHA" ] && continue
    # An annotated tag names a tag object; the commit it points at is what gets checked.
    commit_sha="$(git rev-parse --verify --quiet "$local_sha^{commit}")" || commit_sha="$local_sha"
    case "$CHECKED_SHAS" in
    *" $commit_sha "*) continue ;;
    esac
    CHECKED_SHAS="$CHECKED_SHAS$commit_sha "
    local_sha="$commit_sha"

    scope_name="${local_ref#refs/heads/}"
    scope_name="${scope_name#refs/tags/}"
    [ "$PUSHED_COMMITS" -gt 1 ] && CHECK_SCOPE="$scope_name: "

    TOUCHES_RUST=0
    TOUCHES_WEB=0
    classify_range "$local_sha" "$remote_sha"
    [ "$TOUCHES_RUST" = 1 ] || [ "$TOUCHES_WEB" = 1 ] || continue
    CHECKED_ANY=1

    # The checkout itself is the commit being pushed only when HEAD is that
    # commit and nothing uncommitted or untracked would leak into the checks:
    # a file the author forgot to add compiles here and fails everywhere else.
    if [ "$local_sha" = "$CHECKOUT_HEAD" ] && [ -z "$(git status --porcelain --untracked-files=normal)" ]; then
        dir="$REPO_ROOT"
        PRE_PUSH_TARGET_DIR="${CARGO_TARGET_DIR:-$REPO_ROOT/target}"
        echo -e "${BOLD}Checking $local_ref in place.${NC}"
    else
        if ! prepare_worktree "$local_sha"; then
            cleanup
            FAILED+=("${CHECK_SCOPE}temporary worktree")
            echo -e "${RED}FAILED: preparing a temporary worktree for $local_ref${NC}" >&2
            continue
        fi
        dir="$TEMP_TREE"
        PRE_PUSH_TARGET_DIR="$REPO_ROOT/target/pre-push"
        echo -e "${BOLD}Checking $local_ref in $TREE_NAME.${NC}"
    fi

    if [ "$TOUCHES_RUST" = 1 ]; then
        run_rust_checks "$dir" "$local_sha"
    fi
    [ "$TOUCHES_WEB" = 1 ] && run_web_checks "$dir"
    cleanup
done

if [ "$CHECKED_ANY" = 0 ]; then
    exit 0
fi

echo >&2
for name in ${PASSED[@]+"${PASSED[@]}"}; do
    echo -e "${GREEN}  passed: $name${NC}" >&2
done
for name in ${FAILED[@]+"${FAILED[@]}"}; do
    echo -e "${RED}  FAILED: $name${NC}" >&2
done
if [ -n "$SHEAR_NOTE" ]; then
    echo -e "${YELLOW}  NOTE: $SHEAR_NOTE${NC}" >&2
fi

if [ "${#FAILED[@]}" -gt 0 ]; then
    echo -e "${RED}${BOLD}Pre-push checks failed (${#FAILED[@]}).${NC} Each check's output is above. Fix every failure, commit, and push again." >&2
    exit 1
fi

echo -e "${GREEN}Pre-push checks passed.${NC}" >&2
