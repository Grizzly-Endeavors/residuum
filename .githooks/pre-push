#!/usr/bin/env bash
#
# Pre-push gate: the slow checks, once per push, on the branch as it would be
# merged with the current main.
#
# Rust changes in the pushed range run clippy and the whole test suite; web
# changes run ESLint and the style lint, svelte-check and the web tests. Every
# check runs even after one fails, so a push reports all of its problems at
# once instead of one per attempt, and a summary at the end lists what failed.
#
# Bypassing this hook with --no-verify is forbidden, for a push as for a
# commit. If it fails, fix the underlying issue — a hook you route around is a
# hook that isn't there.
set -uo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BOLD='\033[1m'
NC='\033[0m'

ZERO_SHA=0000000000000000000000000000000000000000
MAIN_REF=refs/remotes/origin/main

note() { echo -e "${YELLOW}$1${NC}" >&2; }

REPO_ROOT="$(git rev-parse --show-toplevel)"
CHECKOUT_HEAD="$(git rev-parse HEAD)"
# In a linked worktree git exports GIT_DIR to this hook. Every git command run
# elsewhere would inherit it and act on this repository instead: the merge in
# the temporary worktree, and any tool or test that runs git in a directory of
# its own (cargo deny's advisory database update once ran
# `git reset --hard FETCH_HEAD` against a worktree's repository this way).
# Without it, git finds the repository from the working directory.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
# The worktree shares this checkout's build output, so the merge is checked
# with warm dependencies instead of a cold build of the whole tree.
SHARED_TARGET_DIR="${CARGO_TARGET_DIR:-$REPO_ROOT/target}"

# Git passes one line per pushed ref on stdin. Read them all up front: the
# checks below run tools that would otherwise read the rest of it.
mapfile -t PUSHED_REFS

# A fetch that can't reach the remote must not hang on a credential prompt.
if ! GIT_TERMINAL_PROMPT=0 git fetch --quiet origin "+refs/heads/main:$MAIN_REF"; then
    note "WARNING: couldn't fetch main from origin; checking the pushed commits without merging main into them."
    MAIN_AVAILABLE=0
elif git rev-parse --verify --quiet "$MAIN_REF" >/dev/null; then
    MAIN_AVAILABLE=1
else
    MAIN_AVAILABLE=0
fi

# Which parts of the tree the commits being pushed change. The range starts at
# what the remote already has, or for a new branch where it left main. With
# neither, every check runs.
TOUCHES_RUST=0
TOUCHES_WEB=0
classify_range() {
    local local_sha="$1" remote_sha="$2" base=""
    if [ "$remote_sha" != "$ZERO_SHA" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        base="$remote_sha"
    elif [ "$MAIN_AVAILABLE" = 1 ]; then
        base="$(git merge-base "$local_sha" "$MAIN_REF" 2>/dev/null)"
    fi
    if [ -z "$base" ]; then
        TOUCHES_RUST=1
        TOUCHES_WEB=1
        return
    fi
    local changed
    changed="$(git diff --name-only "$base" "$local_sha")"
    # assets/ is embedded in the binary, so it can break the build and tests.
    grep -qE '\.rs$|\.toml$|(^|/)Cargo\.lock$|^assets/' <<<"$changed" && TOUCHES_RUST=1
    grep -q '^web/' <<<"$changed" && TOUCHES_WEB=1
}

# Every check runs and its result is recorded; nothing exits early.
FAILED=()
PASSED=()
run_check() {
    local name="$1"
    shift
    echo -e "${BOLD}==> $name${NC}"
    local started=$SECONDS
    if "$@" </dev/null; then
        PASSED+=("$name ($((SECONDS - started))s)")
    else
        FAILED+=("$name ($((SECONDS - started))s)")
        echo -e "${RED}FAILED: $name${NC}" >&2
    fi
}

# Install web dependencies when they are missing or older than the lockfile,
# as `just` does before any web recipe.
ensure_web_deps() {
    local web="$1"
    # A node_modules borrowed from this checkout was matched to the lockfile
    # when it was linked, and the fresh checkout makes the lockfile look newer
    # than it. npm ci would empty the checkout's copy through the link.
    [ -L "$web/node_modules" ] && return 0
    [ "$web/node_modules/.package-lock.json" -nt "$web/package-lock.json" ] && return 0
    echo "Installing web dependencies in $web..."
    (cd "$web" && npm ci --no-audit --no-fund >/dev/null)
}

TEMP_DIR=""
TEMP_TREE=""
cleanup() {
    [ -n "$TEMP_DIR" ] || return 0
    # Unlink the borrowed node_modules first so nothing below can reach
    # through it into this checkout's copy.
    [ -L "$TEMP_TREE/web/node_modules" ] && rm -f "$TEMP_TREE/web/node_modules"
    git worktree remove --force "$TEMP_TREE" >/dev/null 2>&1 || rm -rf "$TEMP_TREE"
    git worktree prune >/dev/null 2>&1
    rm -rf "$TEMP_DIR"
    TEMP_DIR=""
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Check out the pushed commit, merged with main when it is behind, in a
# temporary worktree that borrows this checkout's caches. Leaves its path in
# TEMP_TREE; fails when the merge conflicts. Never call it in a subshell: the
# cleanup trap needs the paths it sets.
prepare_worktree() {
    local sha="$1" merge="$2"
    cleanup
    TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/residuum-pre-push.XXXXXX")" || return 1
    TEMP_TREE="$TEMP_DIR/tree"
    git worktree add --quiet --detach "$TEMP_TREE" "$sha" >&2 || return 1
    if [ "$merge" = 1 ]; then
        # --no-commit leaves the merge in the working tree, where the checks
        # read it, without needing a committer identity or running commit
        # hooks for a commit nobody keeps.
        if ! git -C "$TEMP_TREE" merge --quiet --no-ff --no-commit "$MAIN_REF" >&2; then
            echo -e "${RED}ERROR: this branch conflicts with origin/main.${NC}" >&2
            echo "Merge main into it (git merge origin/main), resolve the conflicts, commit, and push again." >&2
            return 1
        fi
    fi
    # Symlinking node_modules skips an install, which only holds while the
    # merge leaves the lockfile as this checkout has it.
    if [ -d "$REPO_ROOT/web/node_modules" ] && cmp -s "$REPO_ROOT/web/package-lock.json" "$TEMP_TREE/web/package-lock.json"; then
        ln -s "$REPO_ROOT/web/node_modules" "$TEMP_TREE/web/node_modules"
    fi
}

run_rust_checks() {
    local dir="$1"
    (
        cd "$dir" || exit 1
        # build.rs refuses to compile without web/dist, and the gateway's
        # tests read the built service worker. Build it from the sources
        # being checked rather than reusing a dist that may predate them.
        if [ "$dir" != "$REPO_ROOT" ] || [ ! -f web/dist/index.html ] || [ ! -f web/dist/sw.js ]; then
            ensure_web_deps web || exit 1
            echo "Building web/dist..."
            (cd web && npm run build >/dev/null) || exit 1
        fi
    ) || {
        FAILED+=("web build for the Rust checks")
        echo -e "${RED}FAILED: building web/dist, which the Rust build needs. Skipping clippy and the tests.${NC}" >&2
        return
    }
    run_check "clippy" cargo_in "$dir" clippy --all-targets --all-features -- -D warnings
    run_check "cargo test" cargo_in "$dir" test --quiet --no-fail-fast
}

cargo_in() {
    local dir="$1"
    shift
    (cd "$dir" && CARGO_TARGET_DIR="$SHARED_TARGET_DIR" cargo "$@")
}

run_web_checks() {
    local dir="$1"
    if ! ensure_web_deps "$dir/web"; then
        FAILED+=("npm ci")
        echo -e "${RED}FAILED: installing web dependencies. Skipping the web checks.${NC}" >&2
        return
    fi
    run_check "web lint (ESLint, style lint)" npm --prefix "$dir/web" run lint
    run_check "web type check (svelte-check)" npm --prefix "$dir/web" run check
    run_check "web tests (Vitest)" npm --prefix "$dir/web" test
}

CHECKED_ANY=0
for line in "${PUSHED_REFS[@]}"; do
    read -r local_ref local_sha _remote_ref remote_sha <<<"$line"
    # Deleting a remote branch pushes nothing to check.
    [ "$local_sha" = "$ZERO_SHA" ] && continue

    TOUCHES_RUST=0
    TOUCHES_WEB=0
    classify_range "$local_sha" "$remote_sha"
    [ "$TOUCHES_RUST" = 1 ] || [ "$TOUCHES_WEB" = 1 ] || continue
    CHECKED_ANY=1

    merge=0
    if [ "$MAIN_AVAILABLE" = 1 ] && ! git merge-base --is-ancestor "$MAIN_REF" "$local_sha"; then
        if git merge-base "$local_sha" "$MAIN_REF" >/dev/null 2>&1; then
            merge=1
        else
            # A shallow clone can lack the history that joins the two.
            note "WARNING: $local_ref shares no history with origin/main here (a shallow clone?); checking it without merging main."
        fi
    fi

    # The checkout itself is the commit being pushed only when HEAD is that
    # commit and nothing uncommitted or untracked would leak into the checks:
    # a file the author forgot to add compiles here and fails everywhere else.
    if [ "$merge" = 0 ] && [ "$local_sha" = "$CHECKOUT_HEAD" ] && [ -z "$(git status --porcelain)" ]; then
        dir="$REPO_ROOT"
        echo -e "${BOLD}Checking $local_ref in place.${NC}"
    else
        if [ "$merge" = 1 ]; then
            echo -e "${BOLD}Checking $local_ref merged with origin/main in a temporary worktree.${NC}"
        else
            echo -e "${BOLD}Checking $local_ref in a temporary worktree.${NC}"
        fi
        prepare_worktree "$local_sha" "$merge" || exit 1
        dir="$TEMP_TREE"
    fi

    [ "$TOUCHES_RUST" = 1 ] && run_rust_checks "$dir"
    [ "$TOUCHES_WEB" = 1 ] && run_web_checks "$dir"
    cleanup
done

if [ "$CHECKED_ANY" = 0 ]; then
    exit 0
fi

if [ "${#FAILED[@]}" -gt 0 ]; then
    echo >&2
    echo -e "${RED}${BOLD}Pre-push checks failed:${NC}" >&2
    for name in "${FAILED[@]}"; do
        echo -e "${RED}  - $name${NC}" >&2
    done
    [ "${#PASSED[@]}" -gt 0 ] && echo "Passed: ${PASSED[*]}" >&2
    echo "Each check's output is above. Fix the failures, commit, and push again." >&2
    exit 1
fi

echo -e "${GREEN}Pre-push checks passed: ${PASSED[*]}${NC}"
