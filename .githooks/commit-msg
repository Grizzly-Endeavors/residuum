#!/usr/bin/env bash
#
# Commit message check. Advisory by design — it nudges toward a house style
# without standing between you and a commit. Only a genuinely useless subject
# line fails.
set -uo pipefail

YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

MSG_FILE="$1"
SUBJECT="$(head -n1 "$MSG_FILE")"

# Merge commits are generated, not authored.
case "$SUBJECT" in
Merge*) exit 0 ;;
esac

if [ "${#SUBJECT}" -lt 10 ]; then
    echo -e "${RED}ERROR: Commit subject is too short (${#SUBJECT} chars, need 10+).${NC}" >&2
    echo "Say what changed, not just that something did." >&2
    exit 1
fi

if [ "${#SUBJECT}" -gt 72 ]; then
    echo -e "${YELLOW}WARNING: Subject is ${#SUBJECT} chars; 72 or fewer reads better in git log.${NC}"
fi

case "$SUBJECT" in
*.) echo -e "${YELLOW}WARNING: Subject ends with a period — conventionally omitted.${NC}" ;;
esac

if ! grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?!?: ' <<<"$SUBJECT"; then
    echo -e "${YELLOW}TIP: Conventional prefixes make history skimmable:${NC}"
    echo "     feat: fix: docs: refactor: perf: test: ci: chore:"
fi

exit 0
